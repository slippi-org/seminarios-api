# seminarios-api configuration -- TEMPLATE
#
# This repo is PUBLIC. Nothing secret belongs in it. Copy this to .env next to
# the compose file on the Pi (/home/aaron/docker/.env, already gitignored) and
# fill it in there. Same idiom as gitility's scripts/backup/secrets.env.example.

# Path to the SQLite database INSIDE the container. The bind mount puts the real
# file at /home/aaron/docker/seminarios/data/ on the host.
SEM_DB_PATH=/data/seminarios.sqlite

# Exact allowed origins, comma-separated. Never "*".
# Add a localhost origin while developing the frontend, e.g.
#   SEM_CORS_ORIGINS=https://seminarios.slippi.org,http://localhost:8899
SEM_CORS_ORIGINS=https://seminarios.slippi.org

# v1 ships false. Flipping this on exposes visibility='public' rows to
# unauthenticated readers -- a config change, not a code change (PLAN.md §6).
SEM_PUBLIC_READ=false

# Used by manage.py when it prints an enrollment magic link.
SEM_SITE_BASE_URL=https://seminarios.slippi.org

# Limits. Defaults match PLAN.md §6; override only with a reason.
#SEM_MAX_BODY_BYTES=65536
#SEM_MAX_EVENT_TEXT=4000
#SEM_MAX_NOTE_TEXT=20000
#SEM_WRITES_PER_MIN=60
#SEM_WRITES_PER_DAY=500
#SEM_FAILED_AUTH_PER_MIN=10

# --- Not read by the API; belongs to the compose file next to it -------------
# Remote-managed Cloudflare tunnel token, from the Zero Trust dashboard.
#CLOUDFLARED_TUNNEL_TOKEN=
# Where the API source is checked out, for the compose `build:` context.
#SEMINARIOS_API_SRC=/home/aaron/Documents/GitHub/seminarios-api
